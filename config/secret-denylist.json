{
  "schemaVersion": 1,
  "contentScanExclusions": [
    "config/secret-denylist.json"
  ],
  "ignoredDirectories": [
    ".git",
    "node_modules",
    "dist",
    "build",
    "out",
    ".next",
    ".netlify",
    ".supabase",
    "coverage"
  ],
  "allowedEnvironmentExamples": [
    ".env.example"
  ],
  "forbiddenPathRules": [
    {
      "id": "environment-file",
      "pattern": "(^|/)\\.env($|\\.)"
    },
    {
      "id": "database-file",
      "pattern": "\\.(sqlite|sqlite3|db)([-.].*)?$"
    },
    {
      "id": "database-sidecar",
      "pattern": "[-.](wal|shm)$"
    },
    {
      "id": "private-key-material",
      "pattern": "\\.(pem|key|p12|pfx)$"
    },
    {
      "id": "service-account-file",
      "pattern": "(^|/)service-account[^/]*\\.json$"
    },
    {
      "id": "original-runtime-data",
      "pattern": "^(data|r2-import|uploads|backups)(/|$)"
    }
  ],
  "forbiddenContentRules": [
    {
      "id": "private-key-block",
      "pattern": "-----BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY-----",
      "flags": "i"
    },
    {
      "id": "credentialed-postgres-url",
      "pattern": "postgres(?:ql)?:\\/\\/[^\\s:@]+:[^\\s@]+@",
      "flags": "i"
    },
    {
      "id": "server-secret-assignment",
      "pattern": "(?:SUPABASE_SERVICE_ROLE_KEY|SERVICE_ROLE_KEY|DATABASE_URL|POSTGRES_URL|JWT_SECRET|NETLIFY_AUTH_TOKEN|CLOUDFLARE_API_TOKEN)\\s*[:=]\\s*[\\\"']?(?!<|your_|replace_|example|placeholder)[A-Za-z0-9._\\-]{20,}",
      "flags": "i"
    },
    {
      "id": "jwt-like-token",
      "pattern": "eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}"
    },
    {
      "id": "known-production-host",
      "pattern": "ss\\.pauuu\\.dev",
      "flags": "i"
    },
    {
      "id": "known-production-ip",
      "pattern": "(^|[^0-9])47\\.242\\.17\\.43([^0-9]|$)"
    }
  ],
  "textExtensions": [
    ".cjs",
    ".css",
    ".html",
    ".js",
    ".json",
    ".jsx",
    ".md",
    ".mjs",
    ".sql",
    ".toml",
    ".ts",
    ".tsx",
    ".txt",
    ".yaml",
    ".yml"
  ],
  "intentionalPublicDemoCredentials": {
    "note": "Only the documented demo usernames and the literal demo password are allowed; they are not production secrets.",
    "usernames": [
      "devpau",
      "testteacher",
      "teststudent"
    ],
    "password": "password"
  }
}

