# Public browser-safe demo configuration
SUPABASE_URL=https://your_demo_project_ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_demo_publishable_key

# Server/CLI-only placeholders; never expose these in a browser bundle
SUPABASE_PROJECT_ID=your_demo_project_ref
SUPABASE_SECRET_KEY=replace_with_server_only_secret_key
SUPABASE_DB_PASSWORD=replace_with_database_password
SUPABASE_ACCESS_TOKEN=replace_with_personal_access_token
