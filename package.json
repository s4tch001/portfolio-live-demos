{
  "name": "portfolio-live-demos",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Isolated, resettable live previews for the pauuu.dev portfolio.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s4tch001/portfolio-live-demos.git"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.11.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24 <25",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11 <12",
      "onFail": "error"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "audit:isolation": "node scripts/verify-isolation.mjs",
    "audit:isolation:ci": "node scripts/verify-isolation.mjs --workspace-only",
    "audit:netlify:live": "node scripts/verify-netlify-live.mjs",
    "audit:supabase": "node scripts/verify-supabase-config.mjs",
    "audit:toolchain": "node scripts/verify-toolchain.mjs",
    "build": "npm run build:apps",
    "build:apps": "npm run build --workspace @pauuu-demo/cn && npm run build --workspace @pauuu-demo/rcmi && npm run build --workspace @pauuu-demo/hours && npm run build --workspace @pauuu-demo/payroll && npm run build --workspace @pauuu-demo/travels",
    "test": "npm run test:demo-shell && npm run test:reset-control && npm run test:cn && npm run test:rcmi && npm run test:hours && npm run test:payroll && npm run test:travels && npm run test:phase3 && npm run test:phase4.1 && npm run test:phase4.2 && npm run test:phase4.3 && npm run test:phase4.4 && npm run test:phase4.5",
    "test:demo-shell": "npm test --workspace @pauuu-demo/demo-shell",
    "test:reset-control": "node --check supabase/functions/reset-coordinator/index.ts && node --check supabase/functions/_shared/reset-storage.js && node --test supabase/tests/*.test.mjs",
    "test:cn": "npm test --workspace @pauuu-demo/cn",
    "test:rcmi": "npm test --workspace @pauuu-demo/rcmi",
    "test:hours": "npm test --workspace @pauuu-demo/hours",
    "test:payroll": "npm test --workspace @pauuu-demo/payroll",
    "test:travels": "npm test --workspace @pauuu-demo/travels",
    "test:phase3": "node --test test/phase-3-integration.test.mjs",
    "test:phase4.1": "node --test test/phase-4-1-deployment.test.mjs",
    "test:phase4.2": "node --test test/phase-4-2-edge-deployment.test.mjs",
    "test:phase4.3": "node --test test/phase-4-3-reset-scheduler.test.mjs",
    "test:phase4.4": "node --test test/phase-4-4-netlify-deployment.test.mjs",
    "test:phase4.5": "node --test test/phase-4-5-custom-domains.test.mjs",
    "check": "npm run audit:isolation && npm run audit:toolchain && npm run audit:supabase && npm test",
    "check:ci": "npm run audit:isolation:ci && npm run audit:toolchain && npm run audit:supabase && npm test",
    "supabase": "supabase",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:db-reset": "supabase db reset"
  },
  "devDependencies": {
    "@supabase/server": "1.4.1",
    "supabase": "2.109.1"
  }
}
